<Project Sdk="Microsoft.NET.Sdk">
  <!--
    GameAssembly.dll の逆アセンブラ（調査用）。BepInEx/core に入っている LibCpp2IL（IL2CPP のメタデータとバイナリの読み取り）と
    Iced（x86 の逆アセンブル）を使う。使い方は Program.cs の先頭と _ModSource/README.md の「調査用ツール」を参照。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>disasm</AssemblyName>
    <!-- ゲームのフォルダ（このファイルから 3 つ上） -->
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildThisFileDirectory)..\..\..</GameDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="LibCpp2IL"><HintPath>$(BepInExCore)\LibCpp2IL.dll</HintPath></Reference>
    <Reference Include="Iced"><HintPath>$(BepInExCore)\Iced.dll</HintPath></Reference>
    <Reference Include="AssetRipper.Primitives"><HintPath>$(BepInExCore)\AssetRipper.Primitives.dll</HintPath></Reference>
    <Reference Include="StableNameDotNet"><HintPath>$(BepInExCore)\StableNameDotNet.dll</HintPath></Reference>
  </ItemGroup>
</Project>
